{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Tankhor",
    "version": "1.4.6"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "app": {
        "all": true
      },
      "process": {
        "relaunch": true,
        "exit": true
      },
      "updater": {
        "all": true,
        "dialog": false
      },
      "shell": {
        "all": false,
        "open": true
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/brandyar/SizeGrid/main/public/latest.json",
        "https://raw.githubusercontent.com/brandyar/SizeGrid/master/public/latest.json",
        "https://raw.githubusercontent.com/tankhor/tankhor-app/main/public/latest.json",
        "https://tankhor.com/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5MEI5RUQ2MUU5MkMzMTMKUldRVHc1SWUxcDRMYWNZSktTai9LWWZsWEpmVHJVbUt6SktGaUdwMmFseWdldTNZekhsaHNhNlYK"
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.tankhor.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Tankhor - Clothing & Inventory Management",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
